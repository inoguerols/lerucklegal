---
import { site, nav } from "../data/site";
const path = Astro.url.pathname;
const isActive = (href) => (href === "/" ? path === "/" : path.startsWith(href));
---
<div class="contact-bar">
  <div class="container-prose">
    <a href={`mailto:${site.email}`}>{site.email}</a>
    {site.phone && site.phoneHref && <a href={`tel:${site.phoneHref}`}>{site.phone}</a>}
  </div>
</div>
<header class="sticky top-0 z-40 bg-white border-b border-sage-200">
  <div class="container-prose flex items-center justify-between h-20 gap-5">
    <a href="/" class="brand-lockup" aria-label={`${site.name} — inicio`}>
      <img src="/monogram.webp" width="44" height="80" alt="" />
      <span>LE RUCK LEGAL</span>
    </a>

    <nav class="hidden xl:flex items-center gap-6" aria-label="Principal">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={["text-sm font-medium text-navy-900 hover:text-navy-700 transition", isActive(item.href) && "underline underline-offset-8 decoration-2"]}
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <button id="menu-toggle" class="xl:hidden inline-flex items-center justify-center w-11 h-11 rounded text-navy-900" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
  </div>

  <div id="mobile-menu" hidden class="xl:hidden border-t border-sage-500/40 bg-sage-400">
    <nav class="container-prose py-4 flex flex-col gap-1" aria-label="Principal móvil">
      {nav.map((item) => (
        <a href={item.href} class="py-2 text-navy-900 font-medium" aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>
      ))}
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => {
    const open = menu?.hasAttribute("hidden");
    if (open) { menu?.removeAttribute("hidden"); btn?.setAttribute("aria-expanded", "true"); btn?.setAttribute("aria-label", "Cerrar menú"); }
    else { menu?.setAttribute("hidden", ""); btn?.setAttribute("aria-expanded", "false"); btn?.setAttribute("aria-label", "Abrir menú"); }
  });
</script>
