---
// El sitio solo instala cookies técnicas (exentas, art. 22.2 LSSI), así que no hay nada que
// consentir: el aviso es informativo y solo deja constancia de que se ha visto.
// ponytail: si algún día se añade analítica con cookies, aquí vuelven "Aceptar"/"Rechazar" con
// igual prominencia (criterio AEPD, mayo 2024) y la carga del script solo tras "Aceptar".
---
<div id="cookie-banner" hidden class="fixed inset-x-0 bottom-0 z-50 bg-white border-t border-navy-900/15 shadow-[0_-4px_20px_rgba(0,0,0,0.08)]">
  <div class="container-prose py-4 flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
    <p class="text-sm text-navy-800 max-w-2xl">
      Este sitio solo usa cookies técnicas necesarias para su funcionamiento: no medimos tu
      navegación ni la compartimos con terceros. Más información en la
      <a href="/cookies" class="text-sage-600 underline font-medium">Política de cookies</a>.
    </p>
    <div class="flex items-center gap-2 shrink-0">
      <button data-consent="ack" class="text-sm font-semibold px-4 py-2 rounded-full bg-navy-900 text-white hover:bg-navy-800">Entendido</button>
    </div>
  </div>
</div>

<script>
  const KEY = "lrl-cookie-consent";
  const banner = document.getElementById("cookie-banner");
  if (banner && !localStorage.getItem(KEY)) banner.removeAttribute("hidden");
  banner?.querySelectorAll("[data-consent]").forEach((b) => {
    b.addEventListener("click", () => {
      localStorage.setItem(KEY, b.getAttribute("data-consent"));
      banner.setAttribute("hidden", "");
      // Si en el futuro se añade analítica con cookies, cargarla SOLO aquí cuando sea "accept".
    });
  });
</script>
