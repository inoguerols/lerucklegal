---
import Base from "../../layouts/Base.astro";
import JsonLd from "../../components/JsonLd.astro";
import { site, team, areas } from "../../data/site";

export function getStaticPaths() {
  return team.map((m) => ({ params: { slug: m.slug }, props: { lawyer: m } }));
}
const { lawyer } = Astro.props;
const areaTitle = (slug) => slug === "planificacion-fiscal" ? "Derecho fiscal" : areas.find((a) => a.slug === slug)?.title ?? slug;
const title = `${lawyer.name} — ${site.name}`;
const email = lawyer.email ?? site.email;
const phone = lawyer.phone ?? site.phone;
const phoneHref = lawyer.phoneHref ?? site.phoneHref;
const whatsappNumber = lawyer.phoneHref?.replace(/^\+/, "") ?? site.whatsapp;
const whatsapp = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(`Hola, me gustaría contactar con ${lawyer.name} para una consulta.`)}`;
const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: lawyer.name,
  image: lawyer.photo ? new URL(lawyer.photo, site.url).href : undefined,
  jobTitle: lawyer.role,
  url: new URL(`/equipo/${lawyer.slug}`, site.url).href,
  email,
  telephone: phoneHref,
  knowsLanguage: lawyer.languages,
  worksFor: { "@type": "LegalService", name: site.name, url: site.url },
  memberOf: { "@type": "Organization", name: lawyer.colegio },
  knowsAbout: lawyer.areas.map(areaTitle),
};
---
<Base title={title} description={`${lawyer.name}, ${lawyer.role}. ${lawyer.specialty}. ${lawyer.colegiado}.`}>
  <section class="container-prose py-16 md:py-20">
    <a href="/equipo" class="text-sage-600 text-sm font-medium hover:text-navy-900">← Equipo</a>
    <div class:list={["mt-6 grid gap-10 md:items-start", lawyer.photo ? "md:grid-cols-[280px_1fr]" : "max-w-3xl"]}>
      {lawyer.photo && <div class="w-full max-w-xs aspect-[4/5] overflow-hidden bg-sage-100">
        <img src={lawyer.photo} alt={`Retrato de ${lawyer.name}`} width="560" height="700" class="w-full h-full object-cover" style={`transform: scale(${lawyer.photoScale ?? 1}); transform-origin: ${lawyer.photoPosition ?? 'center'};`} />
      </div>}
      <div>
        <h1 class="font-serif text-3xl md:text-4xl text-navy-900">{lawyer.name}</h1>
        <p class="text-sage-600 font-semibold mt-2">{lawyer.role}</p>
        <p class="text-navy-800 mt-2">{lawyer.specialty}</p>
        <p class="text-navy-800 mt-1">{lawyer.colegiado}</p>
        {lawyer.bio.split("\n\n").map((paragraph) => <p class="mt-6 text-lg text-navy-800 leading-relaxed">{paragraph}</p>)}
        {lawyer.education && <section class="mt-8">
          <h2 class="font-serif text-2xl text-navy-900">Formación</h2>
          <p class="mt-3 text-navy-800 leading-relaxed">{lawyer.education}</p>
        </section>}
        {lawyer.formation && <section class="mt-8">
          <h2 class="font-serif text-2xl text-navy-900">Formación</h2>
          <ul class="list-disc pl-5 mt-3 space-y-2 text-navy-800">{lawyer.formation.map(item => <li>{item}</li>)}</ul>
        </section>}
        {lawyer.memberships && <section class="mt-8">
          <h2 class="font-serif text-2xl text-navy-900">Membresías</h2>
          <ul class="list-disc pl-5 mt-3 space-y-2 text-navy-800">{lawyer.memberships.map(item => <li>{item}</li>)}</ul>
        </section>}
        {lawyer.languages && <section class="mt-8">
          <h2 class="font-serif text-2xl text-navy-900">Idiomas</h2>
          <p class="mt-3 text-navy-800">{lawyer.languages}</p>
        </section>}
        {lawyer.clients && <section class="mt-8">
          <h2 class="font-serif text-2xl text-navy-900">A quién asesora</h2>
          <p class="mt-3 text-navy-800 leading-relaxed">{lawyer.clients}</p>
        </section>}
        <div class="mt-6">
          <p class="font-semibold text-navy-900">Áreas</p>
          <ul class="mt-2 flex flex-wrap gap-2">
            {lawyer.areas.map((s) => (
              <li><a href={`/areas/${s}`} class="text-sm px-3 py-1 rounded-full bg-sage-100 text-navy-900 hover:bg-sage-200">{areaTitle(s)}</a></li>
            ))}
          </ul>
        </div>
        <a href={`/${lawyer.card.slug}`} class="inline-block mt-8 mr-5 text-sage-600 underline underline-offset-4">Tarjeta de visita · Guardar contacto</a>
        <section class="mt-8" aria-label="Datos de contacto">
          <h2 class="font-serif text-2xl text-navy-900">{lawyer.phoneHref ? "Contacto directo" : "Contacto del despacho"}</h2>
          <div class="mt-3 flex flex-col items-start gap-3 text-navy-800">
            <a href={`tel:${phoneHref}`} class="underline underline-offset-4">{phone}</a>
            <a href={`mailto:${email}`} class="break-all underline underline-offset-4">{email}</a>
            <a href={whatsapp} class="inline-block bg-navy-900 text-white font-semibold px-6 py-3 rounded-full hover:bg-navy-800 transition">Escribir por WhatsApp</a>
          </div>
        </section>
      </div>
    </div>
  </section>
  <JsonLd schema={schema} />
</Base>
