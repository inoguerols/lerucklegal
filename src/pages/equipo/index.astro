---
import Base from "../../layouts/Base.astro";
import { site, team } from "../../data/site";
const title = `Equipo — ${site.name}`;
const [featured, ...partners] = team;
---
<Base title={title} description="Conoce a los socios de Le Ruck Legal y sus especialidades en derecho civil, planificación patrimonial, derecho financiero y procedimiento tributario.">
  <section class="bg-navy-900 text-white">
    <div class="container-prose py-16 md:py-20">
      <h1 class="font-serif text-4xl md:text-5xl">Abogados con nombre y apellidos</h1>
      <p class="mt-5 text-lg text-sage-100 max-w-2xl">Derecho civil, planificación patrimonial, derecho financiero y procedimiento tributario: conoce a nuestros socios.</p>
    </div>
  </section>
  <section class="container-prose py-16 md:py-20" aria-labelledby="featured-name">
    <div class="grid gap-8 md:gap-12 md:grid-cols-[minmax(0,320px)_1fr] items-center">
      {featured.photo && <img src={featured.photo} alt={featured.name} width="800" height="1000" class="w-full max-w-xs aspect-[4/5] object-cover" />}
      <div>
        <h2 id="featured-name" class="font-serif text-3xl md:text-4xl text-navy-900">{featured.name}</h2>
        <p class="mt-4 text-sage-600 font-semibold max-w-2xl">{featured.role}</p>
        <p class="mt-3 text-sm text-navy-800">{featured.colegiado}</p>
        <p class="mt-6 text-navy-800 max-w-2xl leading-relaxed">{featured.bio.split("\n\n")[0]}</p>
        <a href={`/equipo/${featured.slug}`} class="text-link mt-5">Conocer su trayectoria <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
  <section class="bg-cream py-12 md:py-16" aria-labelledby="partners-title">
    <div class="container-prose">
      <h2 id="partners-title" class="font-serif text-2xl text-navy-900">También forman parte del despacho</h2>
      <div class="mt-8 grid gap-10 md:grid-cols-2">
        {partners.map((partner) => <article>
          <h3 class="font-serif text-xl text-navy-900">{partner.name}</h3>
          <p class="mt-3 text-sm text-navy-800">{partner.role}</p>
          <p class="mt-2 text-sm text-navy-800">{partner.colegiado}</p>
          <a href={`/equipo/${partner.slug}`} class="text-link mt-3">Ver perfil <span aria-hidden="true">↗</span></a>
        </article>)}
        <article>
          <h3 class="font-serif text-xl text-navy-900">Alfonso Mª Montero Sanz</h3>
          <p class="mt-3 text-sm text-navy-800">Socio</p>
        </article>
      </div>
    </div>
  </section>
</Base>
