---
import Base from "../../layouts/Base.astro";
import TeamCard from "../../components/TeamCard.astro";
import { site, team } from "../../data/site";
const title = `Equipo — ${site.name}`;

---
<Base title={title} description="Conoce a los socios de Le Ruck Legal y sus especialidades en derecho civil, patrimonio, derecho inmobiliario y procedimiento tributario.">
  <section class="bg-navy-900 text-white">
    <div class="container-prose py-16 md:py-20">
      <h1 class="font-serif text-4xl md:text-5xl">Tres socios, un compromiso común</h1>
      <p class="mt-5 text-lg text-sage-100 max-w-2xl">Especialistas en derecho tributario, civil y patrimonial. Tres trayectorias complementarias al servicio de cada cliente.</p>
    </div>
  </section>
  <section class="container-prose py-16 md:py-20" aria-labelledby="partners-title">
    <h2 id="partners-title" class="sr-only">Los socios de Le Ruck Legal</h2>
    <div class="grid gap-10 md:grid-cols-3">
      {team.map((lawyer) => <TeamCard lawyer={lawyer} showMembership />)}
    </div>
  </section>
</Base>
