---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
---
<Base title={`Contacto — ${site.name}`} description="Contacta con Le Ruck Legal para consultar tu asunto fiscal, sucesorio o patrimonial.">
  <section class="bg-navy-900 text-white">
    <div class="container-prose py-16 md:py-20">
      <h1 class="font-serif text-4xl md:text-5xl">Hablemos de tu caso.</h1>
      <p class="mt-5 max-w-xl text-sage-100">Contacta con el despacho para consultar tu asunto fiscal, sucesorio o patrimonial.</p>
    </div>
  </section>
  <section class:list={["container-prose py-16 grid gap-12", (site.phone || site.whatsapp) && "md:grid-cols-2"]}>
    <div>
      <h2 class="font-serif text-3xl">Escríbenos</h2>
      <p class="mt-5 mb-7 max-w-xl">Indica un medio de contacto y el motivo general de tu consulta. Evita adjuntar documentación sensible en este primer mensaje.</p>
      <a class="site-button" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
    {(site.phone || site.whatsapp) && <div>
      <h2 class="font-serif text-3xl">Contacto directo</h2>
      <dl class="mt-5 space-y-6">
        {site.phone && site.phoneHref && <div>
          <dt class="text-sm font-semibold">Teléfono</dt>
          <dd><a class="text-link" href={`tel:${site.phoneHref}`}>{site.phone}</a></dd>
        </div>}
        {site.whatsapp && <div>
          <dt class="text-sm font-semibold">WhatsApp</dt>
          <dd><a class="text-link" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">+{site.whatsapp} ↗</a></dd>
        </div>}
        <div>
          <dt class="text-sm font-semibold">Horario de atención</dt>
          <dd>{site.hours}</dd>
        </div>
        <div>
          <dt class="text-sm font-semibold">Domicilio social</dt>
          <dd>{site.address.street}<br />{site.address.postalCode} {site.address.city} ({site.address.region})</dd>
        </div>
      </dl>
    </div>}
  </section>
</Base>
