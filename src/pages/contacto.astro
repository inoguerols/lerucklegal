---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
---
<Base title={`Contacto — ${site.name}`} description="Contacta con Le Ruck Legal para consultar tu asunto fiscal, sucesorio o patrimonial.">
  <section class="bg-navy-900 text-white">
    <div class="container-prose py-16 md:py-20">
      <h1 class="font-serif text-4xl md:text-5xl">Hablemos de tu caso.</h1>
      <p class="mt-5 max-w-xl text-sage-100">Contacta con el despacho para consultar tu asunto fiscal, sucesorio o patrimonial.</p>
    </div>
  </section>
  <section class:list={["container-prose py-16 grid gap-12", (site.phone || site.whatsapp) && "md:grid-cols-2"]}>
    <div>
      <h2 class="font-serif text-3xl">Escríbenos</h2>
      <p id="contact-guidance" class="mt-5 mb-7 max-w-xl">Cuéntanos brevemente el motivo de tu consulta. No incluyas documentos, datos bancarios ni información confidencial. Los campos con * son obligatorios.</p>
      <form id="contact-form" class="contact-form" action="/api/contact" method="POST" aria-describedby="contact-guidance">
        <div>
          <label for="contact-name">Nombre y apellidos *</label>
          <input id="contact-name" name="name" autocomplete="name" required minlength="2" maxlength="100" />
        </div>
        <div class="contact-fields">
          <div>
            <label for="contact-email">Correo electrónico *</label>
            <input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="254" />
          </div>
          <div>
            <label for="contact-phone">Teléfono (opcional)</label>
            <input id="contact-phone" name="phone" type="tel" autocomplete="tel" maxlength="30" />
          </div>
        </div>
        <div>
          <label for="contact-topic">Motivo de consulta *</label>
          <select id="contact-topic" name="topic" required>
            <option value="" disabled selected>Selecciona un motivo</option>
            <option>Herencias y sucesiones</option>
            <option>Donaciones</option>
            <option>No residentes</option>
            <option>Sociedades y fiscalidad</option>
            <option>Inspecciones y recursos</option>
            <option>Otra consulta</option>
          </select>
        </div>
        <div>
          <label for="contact-message">Tu consulta *</label>
          <textarea id="contact-message" name="message" rows="6" required minlength="10" maxlength="3000" aria-describedby="message-help"></textarea>
          <p id="message-help" class="mt-2 text-sm text-sage-600">Entre 10 y 3000 caracteres. Te pediremos la documentación necesaria por un canal adecuado.</p>
        </div>
        <div class="contact-trap" aria-hidden="true">
          <label for="contact-website">Deja este campo vacío</label>
          <input id="contact-website" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <label class="contact-privacy" for="contact-privacy">
          <input id="contact-privacy" name="privacy" type="checkbox" value="read" required />
          <span>He leído la <a href="/privacidad" class="underline underline-offset-4">política de privacidad</a>. *</span>
        </label>
        <p class="text-sm text-navy-800"><strong>Responsable:</strong> {site.legal.titular}. Usaremos tus datos para atender la consulta y, cuando proceda, preparar el encargo solicitado. No te suscribimos a publicidad. Puedes consultar las bases jurídicas y ejercer tus derechos según la <a href="/privacidad" class="underline underline-offset-4">política de privacidad</a>.</p>
        <button type="submit" class="site-button">Enviar consulta</button>
        <p id="contact-status" role="status" aria-live="polite" tabindex="-1" class="contact-status"></p>
      </form>
      <p class="mt-7 text-sm">Si lo prefieres, escribe directamente a <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a>.</p>
    </div>
    {(site.phone || site.whatsapp) && <div>
      <h2 class="font-serif text-3xl">Contacto directo</h2>
      <dl class="mt-5 space-y-6">
        {site.phone && site.phoneHref && <div>
          <dt class="text-sm font-semibold">Teléfono</dt>
          <dd><a class="text-link" href={`tel:${site.phoneHref}`}>{site.phone}</a></dd>
        </div>}
        {site.whatsapp && <div>
          <dt class="text-sm font-semibold">WhatsApp</dt>
          <dd><a class="text-link" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">+{site.whatsapp} ↗</a></dd>
        </div>}
        <div>
          <dt class="text-sm font-semibold">Horario de atención</dt>
          <dd>{site.hours}</dd>
        </div>
        <div>
          <dt class="text-sm font-semibold">Domicilio social</dt>
          <dd>{site.address.street}<br />{site.address.postalCode} {site.address.city} ({site.address.region})</dd>
        </div>
      </dl>
    </div>}
  </section>
<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const status = document.querySelector<HTMLElement>('#contact-status');
  const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  if (form && status && submit) {
    let sending = false;
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (sending) return;
      const payload = JSON.stringify(Object.fromEntries(new FormData(form)));
      const fields = form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea');
      fields.forEach((field) => { field.disabled = true; });
      sending = true;
      submit.disabled = true;
      submit.textContent = 'Enviando…';
      form.setAttribute('aria-busy', 'true');
      status.textContent = 'Enviando tu consulta. No cierres esta página.';
      status.dataset.state = 'sending';
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: payload,
          signal: AbortSignal.timeout(25000),
        });
        const data = await response.json().catch(() => null);
        if (!response.ok || data?.ok !== true) {
          status.textContent = response.status === 429
            ? 'Has enviado varias solicitudes. Espera un minuto antes de volver a intentarlo.'
            : typeof data?.message === 'string' ? data.message : 'No hemos podido confirmar el envío. Conserva tu mensaje y escríbenos por email.';
          status.dataset.state = 'error';
        } else {
          status.textContent = data.message;
          status.dataset.state = 'success';
          form.reset();
        }
      } catch {
        status.textContent = 'No hemos podido confirmar el envío. Comprueba tu conexión, conserva tu mensaje o escríbenos a info@lerucklegal.com.';
        status.dataset.state = 'error';
      } finally {
        sending = false;
        submit.disabled = false;
        submit.textContent = 'Enviar consulta';
        fields.forEach((field) => { field.disabled = false; });
        form.removeAttribute('aria-busy');
        status.focus({ preventScroll: true });
      }
    });
  }
</script>
</Base>
