---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { site } from "../../data/site";
const posts = (await getCollection("actualidad", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const title = `Guías prácticas — ${site.name}`;
const fmt = (d) => d.toLocaleDateString("es-ES", { year: "numeric", month: "long", day: "numeric" });
---
<Base title={title} description="Guías prácticas para afrontar una herencia, planificar una donación o gestionar una herencia en España siendo no residente.">
  <section class="bg-sage-100">
    <div class="container-prose guide-intro">
      <div>
        <h1 class="font-serif text-4xl md:text-5xl">Guías para decidir con criterio</h1>
        <p class="mt-6 text-lg text-navy-800">Qué conviene saber antes de aceptar una herencia, hacer una donación o gestionar patrimonio en España desde otro país.</p>
        <a href="/areas/planificacion-fiscal" class="text-link mt-5">Conocer el Área fiscal <span aria-hidden="true">↗</span></a>
      </div>
      <img src="/equipo/belen-lectura.webp" alt="Belén de Santa Olalla de la Puerta trabajando" width="1100" height="783" class="w-full h-auto" />
    </div>
  </section>
  <section class="container-prose mobile-editorial-section py-16 md:py-20">
    <div class="mobile-flat-list grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((p) => (
        <a href={`/actualidad/${p.id}`} class="block bg-white border border-sage-200 p-7 hover:border-sage-500 transition">
          <p class="text-sm text-sage-600 font-medium">{fmt(p.data.date)}</p>
          <h2 class="font-serif text-xl text-navy-900 mt-2">{p.data.title}</h2>
          <p class="mt-2 text-navy-800">{p.data.description}</p>
          <p class="mt-4 text-sm text-navy-800">Por {p.data.author}</p>
        </a>
      ))}
    </div>
    {posts.length === 0 && <p class="text-navy-800">Próximamente publicaremos nuevas guías.</p>}
  </section>
</Base>
