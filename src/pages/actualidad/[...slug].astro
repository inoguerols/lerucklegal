---
import Base from "../../layouts/Base.astro";
import JsonLd from "../../components/JsonLd.astro";
import { getCollection, render } from "astro:content";
import { site } from "../../data/site";

export async function getStaticPaths() {
  const posts = await getCollection("actualidad", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const related = (await getCollection("actualidad", ({ data }) => !data.draft))
  .filter((entry) => entry.id !== post.id && entry.data.area === post.data.area);
const fmt = (d) => d.toLocaleDateString("es-ES", { year: "numeric", month: "long", day: "numeric" });
const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  author: { "@type": post.data.author === site.name ? "Organization" : "Person", name: post.data.author },
  publisher: { "@type": "Organization", name: site.name },
};
---
<Base title={`${post.data.title} — ${site.name}`} description={post.data.description}>
  <article class="container-prose guide-article py-16 md:py-20">
    <a href="/actualidad" class="text-link">← Guías prácticas</a>
    <p class="mt-6 text-sm text-sage-600 font-medium">{fmt(post.data.date)} · Por {post.data.author}</p>
    <h1 class="font-serif text-3xl md:text-4xl text-navy-900 mt-2">{post.data.title}</h1>
    <div class="legal-copy guide-copy">
      <Content />
    </div>
    <p class="mt-8 text-sm text-sage-600">Información general de carácter divulgativo. Cada caso requiere un análisis jurídico y fiscal individual.</p>
    {post.data.area && <a class="text-link mt-4" href={`/areas/${post.data.area}`}>Ver servicios del Área fiscal <span aria-hidden="true">↗</span></a>}
    <div class="mt-12 p-6 bg-cream rounded-2xl border border-sage-200">
      <p class="text-navy-800">¿Te afecta esto? <a href="/contacto" class="text-sage-600 font-semibold underline">Consúltanos tu caso</a>.</p>
    </div>
    {related.length > 0 && <section class="mt-12" aria-labelledby="related-title">
      <h2 id="related-title" class="font-serif text-2xl">También puede interesarte</h2>
      <ul class="mt-4 space-y-3">
        {related.map((entry) => <li><a class="text-link" href={`/actualidad/${entry.id}`}>{entry.data.title}</a></li>)}
      </ul>
    </section>}
  </article>
  <JsonLd schema={schema} />
</Base>
