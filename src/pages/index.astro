---
import Base from "../layouts/Base.astro";
import JsonLd from "../components/JsonLd.astro";
import { getCollection } from "astro:content";
import { site, areas, faqs } from "../data/site";

const posts = (await getCollection("actualidad", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const photos: Record<string, string> = {
  "planificacion-fiscal": "patrimonio",
  "inspecciones-fiscales": "documentacion",
  "recursos-administrativos": "workspace",
  "contencioso-administrativo": "biblioteca",
};
const faqSchema = {
  "@context": "https://schema.org", "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question", name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---
<Base>
  <section class="home-hero" aria-labelledby="hero-title">
    <div class="hero-message">
      <div class="hero-copy">
        <p class="hero-location">Derecho tributario · Madrid</p>
        <h1 id="hero-title">Tu defensa.<br />Nuestro compromiso.</h1>
        <p>Planificación familiar y patrimonial, liquidación de impuestos y defensa tributaria.</p>
        <a class="site-button" href="/contacto">Contactar <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="hero-portrait">
      <img src="/equipo/belen-despacho.webp" width="1100" height="872" alt="Belén de Santa Olalla de la Puerta, socia de Le Ruck Legal, en su mesa de trabajo" fetchpriority="high" />
    </div>
  </section>

  <div class="brand-statement"><p>{site.tagline}</p></div>

  <section aria-labelledby="practice-title" class="practice-section">
    <div class="section-heading container-prose">
      <h2 id="practice-title">Áreas de práctica</h2>
      <p>Anticipación en el asesoramiento. Rigor en la defensa.</p>
    </div>
    <div class="practice-grid">
      {areas.map((area) => (
        <a href={`/areas/${area.slug}`} class="practice-tile">
          <img src={`/${photos[area.slug]}.jpg`} alt="" width="800" height="600" loading="lazy" />
          <div class="practice-copy">
            <h3>{area.title}</h3>
            <p>{area.short}</p>
            <span class="practice-link">Conocer el área <span aria-hidden="true">↗</span></span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="firm-section container-prose" aria-labelledby="firm-title">
    <div>
      <h2 id="firm-title">Una estrategia compartida.<br />Una defensa a tu medida.</h2>
      <p>En {site.name}, el trabajo en equipo, la honestidad y la eficiencia guían nuestra forma de ejercer la abogacía.</p>
      <p>Acompañamos cada asunto tributario desde el asesoramiento hasta la defensa ante la Administración y los tribunales.</p>
      <a href="/despacho" class="text-link">Conocer el despacho <span aria-hidden="true">↗</span></a>
    </div>
    <aside class="team-note">
      <div class="team-note-copy">
        <h3>El equipo, a tu lado</h3>
        <p>Conoce a las personas detrás de Le Ruck Legal.</p>
        <a href="/equipo" class="text-link">Conocer el equipo <span aria-hidden="true">↗</span></a>
      </div>
    </aside>
  </section>

  <section class="news-section" aria-labelledby="news-title">
    <div class="container-prose">
      <div class="section-heading">
        <h2 id="news-title">Antes de tomar una decisión</h2>
        <p>Guías prácticas sobre herencias, donaciones y fiscalidad de no residentes.</p>
      </div>
      <div class="news-grid">
        {posts.map((post) => (
          <article>
            <h3><a href={`/actualidad/${post.id}`}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
            <a class="text-link" href={`/actualidad/${post.id}`}>Leer guía <span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </div>
      <a href="/actualidad" class="text-link news-more">Ver todas las guías <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="faq-section container-prose" aria-labelledby="faq-title">
    <h2 id="faq-title">Antes de dar el siguiente paso</h2>
    <div>
      {faqs.map((faq) => (
        <details>
          <summary>{faq.q}</summary>
          <p>{faq.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="contact-strip">
    <div class="container-prose">
      <h2>Hablemos de tu caso.</h2>
      <a href="/contacto" class="site-button">Contactar <span aria-hidden="true">↗</span></a>
    </div>
  </section>
  <JsonLd schema={faqSchema} />
</Base>
