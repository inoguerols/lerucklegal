---
import Base from "../layouts/Base.astro";
import JsonLd from "../components/JsonLd.astro";
import { site, categories, areas, stats, faqs } from "../data/site";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---
<Base>
  <section class="relative text-white" style="background-image: linear-gradient(rgba(15,27,45,0.86), rgba(15,27,45,0.94)); background-size: cover; background-position: center;">
    <div class="container-prose py-24 md:py-32 text-center">
      <p data-reveal class="text-sage-200 font-medium tracking-wide uppercase text-sm">Abogados fiscalistas y de derecho patrimonial · Madrid</p>
      <h1 data-reveal data-reveal-delay="1" class="font-serif text-4xl md:text-6xl font-bold mt-4 leading-tight">
        Especialistas en asesoramiento tributario y litigación
      </h1>
      <p data-reveal data-reveal-delay="2" class="mt-6 text-lg md:text-xl text-sage-100 max-w-2xl mx-auto">
        Asesoramos y ofrecemos soluciones especializadas a empresas, grupos familiares y particulares
        en procedimientos tributarios, adecuadas a sus necesidades.
      </p>
      <div data-reveal data-reveal-delay="3" class="mt-9 flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/contacto" class="bg-sage-400 text-navy-900 font-semibold px-7 py-3 rounded-full hover:bg-sage-200 transition">Solicitar consulta</a>
        <a href="/areas" class="border border-white/40 text-white font-semibold px-7 py-3 rounded-full hover:bg-white/10 transition">Conoce nuestras áreas de práctica</a>
      </div>
      <p class="mt-6 text-sm text-sage-200">Trabajo en equipo, honestidad y eficiencia.</p>
    </div>
  </section>

  <!-- BANDA DE CONFIANZA -->
  <section class="bg-cream border-y border-sage-200">
    <div class="container-prose py-10 grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
      {stats.map((s, i) => (
        <div data-reveal data-reveal-delay={String((i % 3) + 1)}>
          <p class="font-serif text-3xl md:text-4xl font-bold text-navy-900">{s.value}</p>
          <p class="text-sm text-navy-800 mt-1">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- INTRO -->
  <section class="container-prose py-16 md:py-20 max-w-3xl">
    <h2 data-reveal class="font-serif text-3xl md:text-4xl text-navy-900">Fiscal y patrimonial, con el mismo rigor</h2>
    <p data-reveal data-reveal-delay="1" class="mt-5 text-lg text-navy-800 leading-relaxed">
      En {site.name} aplicamos los valores que dan nombre al despacho —el <em>ruck</em> del rugby:
      empuje coordinado, disciplina y trabajo en equipo— a dos áreas que en la práctica van de la mano:
      la defensa frente a la Administración tributaria y la organización jurídica del patrimonio
      familiar, desde una herencia hasta una compraventa. Anticipamos los riesgos y construimos la
      estrategia más sólida en cada fase del procedimiento.
    </p>
    <div data-reveal data-reveal-delay="2" class="mt-7 flex flex-wrap gap-3">
      <a href="/despacho" class="text-sage-600 font-semibold underline underline-offset-4 hover:text-navy-900">Conoce el despacho →</a>
    </div>
  </section>

  <!-- ÁREAS -->
  <section class="bg-cream">
    <div class="container-prose py-16 md:py-20">
      <h2 data-reveal class="font-serif text-3xl md:text-4xl text-navy-900 text-center">Áreas de práctica</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        {categories.map((c, i) => (
          <div data-reveal data-reveal-delay={String((i % 2) + 1)} class="card-lift bg-white rounded-2xl p-7 border border-sage-200 hover:border-sage-400 hover:shadow-lg">
            <h3 class="font-serif text-xl text-navy-900">{c.title}</h3>
            <p class="mt-2 text-navy-800">{c.intro}</p>
            <ul class="mt-5 space-y-2">
              {areas.filter((a) => a.category === c.slug).map((a) => (
                <li>
                  <a href={`/areas/${a.slug}`} class="text-sage-600 font-medium hover:text-navy-900">{a.title} →</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- EQUIPO TEASER -->
  <section class="container-prose py-16 md:py-20">
    <div class="md:flex md:items-end md:justify-between">
      <div data-reveal class="max-w-xl">
        <h2 class="font-serif text-3xl md:text-4xl text-navy-900">Un equipo con nombre y apellidos</h2>
        <p class="mt-4 text-navy-800">Detrás de cada caso hay abogados colegiados en el {site.legal.colegio}, especializados en fiscalidad y en derecho civil y patrimonial, comprometidos con tu defensa.</p>
      </div>
      <a href="/equipo" data-reveal data-reveal-delay="1" class="inline-block mt-6 md:mt-0 text-sage-600 font-semibold underline underline-offset-4 hover:text-navy-900">Conoce al equipo →</a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-cream">
    <div class="container-prose py-16 md:py-20 max-w-3xl">
      <h2 data-reveal class="font-serif text-3xl md:text-4xl text-navy-900 text-center">Preguntas frecuentes</h2>
      <div class="mt-10 space-y-4">
        {faqs.map((f) => (
          <details data-reveal class="bg-white rounded-xl border border-sage-200 p-5">
            <summary class="font-semibold text-navy-900 cursor-pointer">{f.q}</summary>
            <p class="mt-3 text-navy-800">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="bg-navy-900 text-white">
    <div class="container-prose py-16 text-center">
      <h2 data-reveal class="font-serif text-3xl md:text-4xl">¿Tienes un asunto fiscal o patrimonial que resolver?</h2>
      <p data-reveal data-reveal-delay="1" class="mt-4 text-sage-100 max-w-xl mx-auto">La primera consulta es confidencial y sin compromiso. Cuéntanos tu caso y te diremos cómo podemos ayudarte.</p>
      <div data-reveal data-reveal-delay="2" class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/contacto" class="bg-sage-400 text-navy-900 font-semibold px-7 py-3 rounded-full hover:bg-sage-200 transition">Solicitar consulta</a>
        <a href={`tel:${site.phoneHref}`} class="border border-white/40 text-white font-semibold px-7 py-3 rounded-full hover:bg-white/10 transition">Llamar: {site.phone}</a>
      </div>
    </div>
  </section>

  <JsonLd schema={faqSchema} />
</Base>
