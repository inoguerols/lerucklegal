---
import Base from "../../layouts/Base.astro";
import { site, areas, categories } from "../../data/site";
const title = `Áreas de práctica — ${site.name}`;
---
<Base title={title} description="Áreas de práctica: inspecciones fiscales, recursos y litigios tributarios, impuestos de no residentes, sucesiones y donaciones, planificación patrimonial y contratos.">
  <section class="bg-navy-900 text-white">
    <div class="container-prose py-20 max-w-3xl">
      <p class="text-sage-200 uppercase tracking-wide text-sm font-medium">Áreas de práctica</p>
      <h1 class="font-serif text-4xl md:text-5xl mt-3">Fiscalidad, litigación y derecho patrimonial</h1>
    </div>
  </section>
  <section class="container-prose py-16 md:py-20 space-y-16">
    {categories.map((c) => (
      <div>
        <h2 id={c.slug} class="font-serif text-3xl text-navy-900 scroll-mt-24">{c.title}</h2>
        <p class="mt-3 text-navy-800 max-w-3xl">{c.intro}</p>
        <div class="mt-8 grid gap-6 md:grid-cols-2">
          {areas.filter((a) => a.category === c.slug).map((a) => (
            <a href={`/areas/${a.slug}`} class="card-lift block bg-white rounded-2xl p-7 border border-sage-200 hover:border-sage-400 hover:shadow-md">
              <h3 class="font-serif text-2xl text-navy-900">{a.title}</h3>
              <p class="mt-3 text-navy-800">{a.summary}</p>
              <span class="mt-4 inline-block text-sage-600 font-semibold">Ver detalle →</span>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>
</Base>
